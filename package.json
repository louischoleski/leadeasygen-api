{
	"name": "@fonderie/starter-template",
	"version": "0.1.0",
	"private": true,
	"description": "A Fonderie-powered SaaS backend starter.",
	"type": "module",
	"scripts": {
		"dev": "npm run migrate && concurrently -k -n api,worker -c cyan,magenta \"npm:dev:api\" \"npm:worker:dev\"",
		"dev:api": "tsx watch src/index.ts",
		"worker": "tsx src/worker.ts",
		"worker:dev": "tsx watch src/worker.ts",
		"build": "tsup src/index.ts --format esm --dts && node -e \"require('fs').cpSync('src/db/migrations/sql','dist/sql',{recursive:true})\"",
		"start": "node dist/index.js",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "node --import tsx --test \"src/**/__tests__/*.test.ts\"",
		"migrate": "tsx src/migrate.ts",
		"migrate:plan": "fonderie migrate --dry-run --app src/db/migrations/sql",
		"migrate:check": "fonderie migrate --check --app src/db/migrations/sql"
	},
	"dependencies": {
		"@fonderie/adapter-express": "^5.4.12",
		"@fonderie/admin": "^1.8.4",
		"@fonderie/auth": "^7.27.5",
		"@fonderie/billing": "^11.5.0",
		"@fonderie/config": "^6.6.10",
		"@fonderie/core": ">=0.33.0",
		"@fonderie/courier": "^7.16.3",
		"@fonderie/events": "^5.13.3",
		"@fonderie/geo": "^0.5.14",
		"@fonderie/media": "^0.5.1",
		"@fonderie/rate-limit": "^4.1.2",
		"@fonderie/risk": "^0.3.11",
		"@fonderie/storage": "^0.1.32",
		"@fonderie/store": ">=0.7.3",
		"@fonderie/workspaces": "^8.0.0",
		"@vercel/functions": "^3.9.7",
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"express": "^4.21.2",
		"nodemailer": "^9.1.1",
		"stripe": "^22.4.0"
	},
	"devDependencies": {
		"@fonderie/cli": ">=0.14.2",
		"@playwright/test": "^1.40.0",
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.2",
		"concurrently": "^10.0.5",
		"oxlint": "^1.81.0",
		"playwright": "^1.40.0",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	}
}
