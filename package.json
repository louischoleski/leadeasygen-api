{
	"name": "@fonderie/starter-template",
	"version": "0.1.0",
	"private": true,
	"description": "A Fonderie-powered SaaS backend starter.",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"worker": "tsx src/worker.ts",
		"worker:dev": "tsx watch src/worker.ts",
		"build": "tsup src/index.ts --format esm --dts",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@fonderie/adapter-express": "*",
		"@fonderie/auth": "*",
		"@fonderie/core": "*",
		"@fonderie/courier": "^5.0.0",
		"@fonderie/events": "*",
		"@fonderie/store": "*",
		"@fonderie/workspaces": "*",
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"express": "^4.21.2",
		"nodemailer": "^9.1.1",
		"stripe": "^22.4.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.2",
		"playwright": "^1.40.0",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	}
}
