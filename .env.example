DATABASE_URL=postgresql://user:password@localhost:5432/postgres
JWT_SECRET=change-me-in-production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the SEPARATE credit-pack payment webhook
# (POST /billing/webhook/payment); the one above covers subscriptions
# (POST /billing/webhook). Stripe issues one secret per endpoint. Unset →
# pack purchases are paid at Stripe but the wallet is never credited.
STRIPE_WALLET_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SMALL=price_...   # 10 credits for $5
STRIPE_PRICE_MEDIUM=price_...  # 50 credits for $20
STRIPE_PRICE_LARGE=price_...   # 100 credits for $38
# Recurring prices for the Unlimited subscription. Unlike the one-time packs
# above (which fall back to an ad-hoc amount when unset), a subscription REQUIRES
# a real recurring Stripe Price — leave these blank and the Unlimited plan is
# unpurchasable ("does not support month/year billing").
STRIPE_PRICE_UNLIMITED_MONTHLY=price_...  # Unlimited plan, $49/mo (recurring)
STRIPE_PRICE_UNLIMITED_YEARLY=price_...    # Unlimited plan, $468/yr (recurring)
FRONTEND_URL=http://localhost:5173

# Transactional email (@fonderie/courier SMTP channel). Leave SMTP_HOST unset to
# disable email delivery — auth still writes verification/reset pins to the DB.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # false = STARTTLS (587), true = implicit TLS (465)
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM=YourApp <hello@email.example.com>
# Where replies go, when the From address cannot receive them. A dedicated
# sending subdomain has no MX, so a reply to From bounces — point this at an
# address that actually delivers. Unset = no Reply-To header.
SMTP_REPLY_TO=hello@example.com

# Optional, and only read by the ops route's sending-domain check — never by the
# send path. SPF/DKIM/DMARC live in public DNS, so a misconfigured domain does
# not fail a send: the receiver silently drops or spam-files the mail.
#
# DKIM selectors cannot be discovered from DNS (the signer picks them), so
# without this the check cannot tell a provider-owned Return-Path (correct) from
# an unauthenticated domain (broken) — it reports the ambiguity instead of
# guessing. Resend publishes one selector named 'resend'.
SMTP_DKIM_SELECTORS=resend
# SPF is checked against the ENVELOPE SENDER, not the From header. Hosted
# providers own the Return-Path on their own bounce subdomain, which is where
# SPF must be. Resend uses send.<your-sending-domain>.
SMTP_RETURN_PATH_DOMAIN=send.email.example.com

# Google sign-in. All THREE are required — with any of them missing the
# provider stays off and /config reports only "email", so the app never renders
# a button that would dead-end on Google's error page. GOOGLE_REDIRECT_URI must
# match the Authorized redirect URI in the Google Cloud console exactly
# (scheme, host, path, no trailing slash).
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<api-host>/auth/google/callback

# Notification delivery. Email is queued to a durable outbox in the same
# transaction-ish moment it is triggered, so it survives the API instance being
# frozen the moment it responds; something then has to DELIVER it. Locally the
# worker (`npm run dev` starts it) LISTENs and sends within milliseconds. On
# serverless there is no worker, so the API drains its own queue after each
# response. Auto-detected — set this only to override:
#   true  — the API delivers (a long-running deploy with no worker)
#   false — something else delivers (a worker beside a serverless API)
# NOTIFY_DRAIN_IN_API=true

# How work that must outlive the response behaves. 'auto' (default) awaits on
# serverless and detaches on a long-running host; on Vercel the platform's
# waitUntil is used instead, which beats both. Override only to force it.
# FONDERIE_BACKGROUND_TASKS=auto
# FONDERIE_BACKGROUND_TIMEOUT_MS=5000

# Trial-abuse defense (@fonderie/risk). Pepper for the risk_events hashes — a
# UNIQUE random secret of at least 32 characters (`openssl rand -hex 32`);
# without it a leaked table is dictionary-attackable offline. In production the
# boot FAILS on a missing/placeholder/short pepper; in development a dev
# fallback is used with a boot warning. NOTE the name: the brick reads
# RISK_PEPPER (this was TRIAL_RISK_PEPPER before the risk-brick migration).
RISK_PEPPER=change-me-long-random-string

# Behind a reverse proxy / load balancer (nginx, ALB), set to the number of
# trusted proxy hops so the client IP is read from X-Forwarded-For (used by
# rate limiting and the trial-risk IP velocity signals). Leave unset when the
# app is directly reachable — with it set there, X-Forwarded-For is
# attacker-chosen. Read by @fonderie/core's resolveClientIp.
# TRUST_PROXY=1

# ── Deployment-only (serverless) ─────────────────────────────────────────────
# Authorises the retention-purge cron (POST /internal/cron/purge). A serverless
# instance is frozen between requests, so the in-process purge timer never
# fires there and a scheduler drives it instead. Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET`. Unset → the route answers 503 rather
# than running unguarded. Not needed for the long-lived server, which uses its
# own timer.
CRON_SECRET=

# ── Which Postgres endpoint? ─────────────────────────────────────────────────
#
# Supabase exposes the SAME database and SAME credentials three ways. They
# differ only in connection semantics, and that is what decides which one a
# given process can use:
#
#   transaction pooler  ...pooler.supabase.com:6543
#       A backend is lent per TRANSACTION and reset on release. Session state
#       (SET, LISTEN, session advisory locks) does not survive between
#       statements. This is the right default and what DATABASE_URL should be:
#       serverless opens many short-lived connections, and any mode that pins a
#       backend per client would exhaust the limit under concurrency.
#
#   session pooler      ...pooler.supabase.com:5432
#       A backend is held for the life of the connection, so session state and
#       LISTEN work. Correct for ONE long-lived process; wrong for serverless,
#       for the reason above.
#
#   direct              db.<ref>.supabase.co:5432
#       Postgres itself. Same semantics as the session pooler, one less hop —
#       but it is IPv6-ONLY (IPv4 is a paid add-on), so it is unreachable from
#       any host without IPv6 egress. Verify before depending on it.
#
# To tell which one a URL actually gives you, ask the server rather than
# reading the port: `SET my.probe='x'` in one statement and `SHOW my.probe` in
# the next. Transaction mode discards it; the others keep it. Port and hostname
# conventions differ per provider and a heuristic silently misreads the next one.
#
# The scrape worker uses this SAME variable. It polls (drain) rather than
# LISTENs precisely so it needs no second, session-mode URL — one credential,
# one config, one less thing to get wrong at deploy time. The cost is that a
# job waits up to WORKER_POLL_MS instead of starting instantly, which is noise
# against a scrape measured in tens of seconds.
#
# One exception still needs session or direct: `npm run migrate`. Migration
# tools take advisory locks that must span statements, and a transaction pooler
# discards them.

# ─── Public URL of THIS api ──────────────────────────────────────────────────
# The absolute base URL this API is reachable at, e.g.
# https://api.leadeasygen.com
#
# Read by the webhook-registration check, served at GET /_admin/doctor and run
# again by the /internal/cron/purge sweep: it asks Stripe what it is configured
# to send and compares against the endpoints THIS deployment serves, so the
# comparison is by URL and must be the exact URL registered in the Stripe
# dashboard.
#
# Worth setting. With it, that check reports the endpoints' Stripe API version
# against the one this client is pinned to — the drift that moves fields
# between versions and is otherwise silent until a payment goes missing.
#
# Deliberately NOT inferred from VERCEL_URL. That is the per-deployment hostname
# (leadeasygen-api-abc123.vercel.app), so it would never match the registered
# endpoint and the check would report every event missing on every run. A check
# that cries wolf is worse than no check.
#
# Unset is safe: the check reports `skipped` rather than guessing.
PUBLIC_API_URL=

# ─── Operator surface (@fonderie/admin) ──────────────────────────────────────
# One token guards everything under /_admin: the manifest, the doctor, the
# config report, the route table, the admin log, and the dashboard served at
# /_admin/ui. Unset ⇒ the surface is NOT REGISTERED AT ALL — 404, not 401 — so
# a preview deployment exposes nothing and an attacker cannot even tell it
# exists.
#
# Treat this as root: it reads which config names are set, mints scoped tokens,
# and reaches every brick's admin routes. At least 32 characters, unique per
# environment (`openssl rand -hex 32`). A short or placeholder value is an
# error at boot in production, not a warning.
#
# Prefer handing a dashboard a SCOPED token minted from the Access page
# (read / write / secrets) over pasting this one into a browser.
ADMIN_TOKEN=

# Hostnames the surface answers for, comma-separated. Vercel routes every
# alias AND every per-deployment preview URL to the same instance, so without
# this /_admin answers at addresses nobody thinks of as the API — including a
# deployment URL that leaks into a link preview or a bot's crawl. Any other
# Host gets 404.
#
# Unset = answer for any host. Right for local work, wrong for production.
# ADMIN_HOST=api.leadeasygen.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Absent = the provider is simply not offered. /auth/providers stops listing
# google and the app hides the button, so a half-configured deploy cannot send
# anyone to Google's error page.
#
# GOOGLE_REDIRECT_URI must match the Authorized redirect URI in the Google Cloud
# Console character for character — scheme, host, path, no trailing slash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Scraper ─────────────────────────────────────────────────────────────────
# Path to a local Chrome/Chromium for the scrape worker. Unset uses Playwright's
# bundled browser, which is what the Cloud Run image does; set it locally to
# reuse an installed Chrome instead of downloading another.
CHROME_EXECUTABLE_PATH=

# ─── Tuning (all optional, sane defaults) ────────────────────────────────────
# Drain the notification outbox from inside the API after a response. On by
# default; set to 'false' where a separate worker owns delivery.
NOTIFY_DRAIN_IN_API=
# Max Postgres connections THIS instance holds. 1 on serverless — every warm
# instance keeps its own pool, so N instances x 10 exhausts the pooler.
PG_POOL_MAX=
# Worker loop: exit after one pass (Cloud Run Job sets WORKER_ONCE=1), how long
# to keep polling, and the gap between polls.
WORKER_ONCE=
WORKER_MAX_MS=
WORKER_POLL_MS=
